# `pnpm dev` and deployments: `vercel env pull` writes these to .env.local.
VEHICLE_API_URL="https://<vehicle-api>.a.run.app"
GCP_PROJECT_NUMBER=""
GCP_WORKLOAD_IDENTITY_POOL_ID=""
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=""
GCP_SERVICE_ACCOUNT_EMAIL=""
# Short-lived (~12h). Used for the GCP exchange and for AI Gateway.
VERCEL_OIDC_TOKEN=""

# `pnpm dev:local` sets these itself: call the local API without a token. Refused on Vercel.
# VEHICLE_API_AUTH="none"
# VEHICLE_API_URL="http://localhost:8080"

# Local AI: an AI Gateway API key (put it in .env.development.local). The AI SDK uses it before
# VERCEL_OIDC_TOKEN, so `pnpm dev:local` needs no Vercel project link. Deployments use OIDC.
# AI_GATEWAY_API_KEY=""
